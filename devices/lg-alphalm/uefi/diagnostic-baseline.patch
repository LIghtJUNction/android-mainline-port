@@ -32,6 +32,13 @@ SPDX-License-Identifier: BSD-2-Clause-Patent
 #define MS_PXE_BOOT       L"PXE Network"
 #define MS_PXE_BOOT_PARM  "PXE"
 
+#ifdef LG_ALPHA_BDS_LINUXLOADER
+STATIC EFI_GUID  mLinuxLoaderFileGuid = {
+  0xf536d559, 0x459f, 0x48fa,
+  { 0x8b, 0xbc, 0x43, 0xb5, 0x54, 0xec, 0xae, 0x8d }
+};
+#endif
+
 typedef struct {
   MEDIA_FW_VOL_DEVICE_PATH    FvDevPath;
   EFI_DEVICE_PATH_PROTOCOL    EndDevPath;
@@ -523,6 +530,10 @@ MsBootOptionsLibRegisterDefaultBootOptions (
 {
   DEBUG ((DEBUG_INFO, "%a\n", __FUNCTION__));
 
+#ifdef LG_ALPHA_BDS_LINUXLOADER
+  // Put LinuxLoader first in the actual BootOrder registration path used by BdsDxe.
+  RegisterFvBootOption (&mLinuxLoaderFileGuid, L"LinuxLoader", 0, LOAD_OPTION_ACTIVE, NULL, 0);
+#endif
   RegisterFvBootOption (&gMsBootPolicyFileGuid, MS_SDD_BOOT, (UINTN)-1, LOAD_OPTION_ACTIVE, (UINT8 *)MS_SDD_BOOT_PARM, sizeof (MS_SDD_BOOT_PARM));
   RegisterFvBootOption (&gMsBootPolicyFileGuid, MS_USB_BOOT, (UINTN)-1, LOAD_OPTION_ACTIVE, (UINT8 *)MS_USB_BOOT_PARM, sizeof (MS_USB_BOOT_PARM));
   RegisterFvBootOption (&gMsBootPolicyFileGuid, MS_PXE_BOOT, (UINTN)-1, LOAD_OPTION_ACTIVE, (UINT8 *)MS_PXE_BOOT_PARM, sizeof (MS_PXE_BOOT_PARM));
diff --git c/Platforms/QcomModulePkg/Application/LinuxLoader/LinuxLoader.c w/Platforms/QcomModulePkg/Application/LinuxLoader/LinuxLoader.c
index e271b2f3..3f936c11 100644
--- c/Platforms/QcomModulePkg/Application/LinuxLoader/LinuxLoader.c
+++ w/Platforms/QcomModulePkg/Application/LinuxLoader/LinuxLoader.c
@@ -194,6 +194,17 @@ LinuxLoaderEntry (IN EFI_HANDLE ImageHandle, IN EFI_SYSTEM_TABLE *SystemTable)
 
   BootStatsSetTimeStamp (BS_BL_START);
 
+#ifdef LG_ALPHA_FORCE_UEFI_FASTBOOT_EARLY
+  // Start UEFI fastboot only after the loader's basic stack/runtime setup,
+  // but before storage, partition or board probing can abort the app.
+  DEBUG ((EFI_D_INFO, "LG alpha fastboot after stack setup\n"));
+  Status = FastbootInitialize ();
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "FastbootInitialize after stack setup failed: %r\n", Status));
+  }
+  goto stack_guard_update_default;
+#endif
+
   // Initialize verified boot & Read Device Info
   Status = DeviceInfoInit ();
   if (Status != EFI_SUCCESS) {
@@ -296,6 +307,13 @@ LinuxLoaderEntry (IN EFI_HANDLE ImageHandle, IN EFI_SYSTEM_TABLE *SystemTable)
     return Status;
   }
 
+#ifdef LG_ALPHA_FORCE_UEFI_FASTBOOT
+  // BoardInit has completed, so the UEFI fastboot USB protocol and board data
+  // have their normal prerequisites.  Keep the host-provided image in the
+  // UEFI fastboot path instead of loading the Android boot partition.
+  BootIntoFastboot = TRUE;
+#endif
+
   DEBUG ((EFI_D_INFO, "KeyPress:%u, BootReason:%u\n", KeyPressed, BootReason));
   DEBUG ((EFI_D_INFO, "Fastboot=%d, Recovery:%d\n",
                                           BootIntoFastboot, BootIntoRecovery));
